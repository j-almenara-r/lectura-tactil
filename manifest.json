{
  "manifest_version": 3,
  "name": "Lectura Tactil",
  "version": "1.0.0",
  "description": "Enable snap scroll functionality on any webpage for better reading experience",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Lectura Tactil Settings"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content_script.js"],
      "css": ["styles.css"],
      "run_at": "document_end"
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "toggle-reading-mode": {
      "suggested_key": {
        "default": "F9"
      },
      "description": "Toggle reading mode with discrete pages"
    }
  }
}
